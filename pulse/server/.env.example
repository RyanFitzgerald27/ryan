# ---------------------------------------------------------------------------
# Pulse server configuration. Copy this file to `.env` and fill in values.
# ---------------------------------------------------------------------------

# Follow Up Boss API key.
# Get one in FUB: Admin -> API. Required for syncing calls & agents.
FUB_API_KEY=

# Optional registered-integration headers. Leave blank when using a plain
# account API key — only needed if FUB issued you an X-System integration.
FUB_X_SYSTEM=
FUB_X_SYSTEM_KEY=

# HTTP port for the API server.
PORT=4000

# Where the SQLite database file lives (relative to pulse/server).
DB_PATH=./data/pulse.db

# Browser origins allowed to call the API. Use * for local dev.
CORS_ORIGIN=*

# Timezone used for "Today / This Week" date ranges and trend buckets.
TIMEZONE=America/New_York

# How many days back to pull on the very first sync.
SYNC_LOOKBACK_DAYS=365

# Calls fetched per FUB API request (max 100).
SYNC_PAGE_SIZE=100

# Auto-sync every N minutes while the server runs. 0 disables it
# (sync manually with the "Sync now" button or `npm run sync`).
SYNC_INTERVAL_MINUTES=0

# A call counts as a "conversation" if it lasts at least this many seconds...
CONVERSATION_MIN_SECONDS=90

# ...OR its FUB call outcome is one of these (comma-separated).
# Edit these to match the outcome names configured in your FUB account.
CONVERSATION_OUTCOMES=Interested,Not Interested,Appointment Set
